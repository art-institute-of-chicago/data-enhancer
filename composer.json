{
    "name": "aic/data-enhancer",
    "description": "A system-of-record for manually cleaned and reconciled data in our public API.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/art-institute-of-chicago/data-hub-foundation.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "aic/data-hub-foundation": "^3.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^10.0",
        "laravel/horizon": "^5.9",
        "laravel/tinker": "^2.5",
        "league/csv": "^9.8",
        "sentry/sentry-laravel": "^3.0",
        "spatie/laravel-slack-alerts": "^1.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.5",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "lint": [
            "@putenv COMPOSER=vendor/aic/data-hub-foundation/composer.json",
            "@composer lint"
        ],
        "format": [
            "@putenv COMPOSER=vendor/aic/data-hub-foundation/composer.json",
            "@composer format"
        ],
        "foundation": [
            "php vendor/aic/data-hub-foundation/composer-dev.php",
            "COMPOSER=composer-dev.json composer update aic/data-hub-foundation"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit --order-by=defects --stop-on-failure"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "netresearch/composer-patches-plugin": true,
            "ocramius/package-versions": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
